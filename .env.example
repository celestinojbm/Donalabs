##############################################################################
# DonaLabs — shared infrastructure environment file
#
# HOW TO USE
#   1. Copy this file:            cp .env.example .env
#   2. Generate all secrets:      ./scripts/generate-secrets.sh
#      (fills every "GENERATE" value below with a strong random secret)
#   3. Review the non-secret settings (ports, domains, feature flags).
#   4. Start the stack:           ./start.sh
#
# NOTES
#   * NEVER commit the real `.env` — it is git-ignored. Only `.env.example`
#     (this file, with placeholder values) belongs in version control.
#   * Values set to "GENERATE" are filled by scripts/generate-secrets.sh.
#   * Do NOT put inline "# comments" after a value on the same line — in a
#     .env file the comment can become part of the value. Keep comments on
#     their own lines (as done here).
#   * Ports below are HOST ports. By default they bind to 127.0.0.1 only
#     (see BIND_ADDR); expose them publicly through the Caddy reverse proxy.
##############################################################################

# =====================================================================
# GLOBAL
# =====================================================================
# Timezone for every service (IANA name, e.g. Europe/Madrid, America/New_York).
TZ=UTC

# Host interface the published ports bind to.
#   127.0.0.1 = only reachable from this host / the Caddy proxy (RECOMMENDED).
#   0.0.0.0   = reachable from the LAN/Internet (only behind a firewall/proxy).
BIND_ADDR=127.0.0.1

# Name of the shared external Docker network that ties the services together
# and that OTHER projects attach to in order to consume these services.
# Created automatically by ./start.sh (or scripts/init-network.sh).
EDGE_NETWORK=donalabs_edge


# =====================================================================
# VAULTWARDEN — password & secrets manager (Bitwarden-compatible)
# Docs: services/vaultwarden/README.md
# =====================================================================
VW_IMAGE_TAG=1.36.0-alpine
VW_HOST_PORT=8200
# Public URL of the vault. Local use: keep http://localhost:8200 (localhost is a
# browser "secure context" so the web-crypto vault works over plain http).
# Real deployment: set your HTTPS URL and serve it via Caddy.
VW_DOMAIN=http://localhost:8200
# Allow self-registration. "true" for first run, then set "false" and restart.
VW_SIGNUPS_ALLOWED=true
# Admin panel token (unlocks /admin). GENERATE with: openssl rand -base64 48
# Kept single-quoted so any '$' is safe.
VW_ADMIN_TOKEN='GENERATE'


# =====================================================================
# CAL.COM — scheduling / bookings platform
# Docs: services/calcom/README.md
# IMPORTANT: NEXT_PUBLIC_WEBAPP_URL is baked into the prebuilt image at BUILD
# time, so the published image only works at http://localhost:3000. For a custom
# domain you must rebuild the image (see services/calcom/README.md).
# =====================================================================
CALCOM_IMAGE_TAG=v6.2.0
CALCOM_HOST_PORT=3000
# Keep http://localhost:3000 unless you rebuild the image (see README).
CALCOM_WEBAPP_URL=http://localhost:3000
# Accept the Cal.com self-hosting license terms.
CALCOM_LICENSE_CONSENT=agree
CALCOM_DB_NAME=calendso
CALCOM_DB_USER=calcom
# GENERATE with: openssl rand -hex 24
CALCOM_DB_PASSWORD=GENERATE
# GENERATE with: openssl rand -base64 32
CALCOM_NEXTAUTH_SECRET=GENERATE
# GENERATE with: openssl rand -base64 24 (yields a 32-byte key; NEVER change it
# after first use or stored calendar/OAuth credentials become undecryptable).
CALCOM_ENCRYPTION_KEY=GENERATE
# Optional outbound email (booking confirmations). Leave blank to disable.
CALCOM_EMAIL_FROM=
CALCOM_SMTP_HOST=
CALCOM_SMTP_PORT=587
CALCOM_SMTP_USER=
CALCOM_SMTP_PASSWORD=


# =====================================================================
# PLAUSIBLE ANALYTICS (Community Edition) — web analytics
# Docs: services/plausible/README.md
# Requires Postgres 16 + ClickHouse 24.12 (both dedicated).
# =====================================================================
PLAUSIBLE_IMAGE_TAG=v3.2.1
PLAUSIBLE_HOST_PORT=8210
# Public URL of the dashboard (also used in the tracking snippet).
PLAUSIBLE_BASE_URL=http://localhost:8210
# "true" disables open registration. Use "false" for first run to create the
# owner account, then set "true" and restart.
PLAUSIBLE_DISABLE_REGISTRATION=false
# GENERATE with: openssl rand -base64 48
PLAUSIBLE_SECRET_KEY_BASE=GENERATE
# GENERATE with: openssl rand -base64 32
PLAUSIBLE_TOTP_VAULT_KEY=GENERATE
PLAUSIBLE_DB_USER=plausible
# GENERATE with: openssl rand -hex 24
PLAUSIBLE_DB_PASSWORD=GENERATE
PLAUSIBLE_DB_NAME=plausible
# File-descriptor (nofile) limits. Defaults match the official Plausible compose.
# Only lower these on constrained hosts where `ulimit -Hn` is below the default
# (Docker cannot raise a container's hard limit above the host's).
PLAUSIBLE_CH_NOFILE=262144
PLAUSIBLE_APP_NOFILE=65535


# =====================================================================
# PENPOT — collaborative design & prototyping platform
# Docs: services/penpot/README.md
# Requires Postgres 15 + Valkey 8.1 (both dedicated).
# =====================================================================
PENPOT_IMAGE_TAG=2.16.2
PENPOT_HOST_PORT=9001
PENPOT_PUBLIC_URI=http://localhost:9001
# Master key from which all subsystem keys derive. GENERATE with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=GENERATE
# Feature flags. Default is safe for LOCAL/http use. For a public HTTPS
# deployment, remove 'disable-email-verification' and
# 'disable-secure-session-cookies' and add 'enable-secure-session-cookies'.
PENPOT_FLAGS=enable-registration enable-login-with-password disable-email-verification disable-secure-session-cookies enable-prepl-server enable-mcp
PENPOT_DB_USER=penpot
# GENERATE with: openssl rand -hex 24
PENPOT_DB_PASSWORD=GENERATE
PENPOT_DB_NAME=penpot
# Disable the frontend's IPv6 nginx listener. "true" is safe everywhere and is
# required on Docker bridges without IPv6; set "false" if you serve IPv6 directly.
PENPOT_DISABLE_IPV6_LISTEN=true
# Optional real SMTP (invitations / resets). Leave blank to keep email disabled.
PENPOT_SMTP_HOST=
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USER=
PENPOT_SMTP_PASSWORD=
PENPOT_SMTP_FROM=no-reply@example.com


# =====================================================================
# n8n — workflow automation platform
# Docs: services/n8n/README.md
# Uses a dedicated Postgres 16.
# =====================================================================
N8N_IMAGE_TAG=2.29.8
N8N_HOST_PORT=5678
# Host + protocol used to build webhook/callback URLs. Keep for local use.
N8N_HOSTNAME=localhost
N8N_PROTOCOL=http
# Full public webhook base URL (MUST end with a trailing slash).
N8N_WEBHOOK_URL=http://localhost:5678/
# Secure cookie needs HTTPS; keep "false" for local http, "true" behind Caddy.
N8N_SECURE_COOKIE=false
# Master encryption key for stored credentials. GENERATE with: openssl rand -hex 32
# WARNING: if lost, all stored credentials become unreadable. Back it up.
N8N_ENCRYPTION_KEY=GENERATE
N8N_DB_USER=n8n
# GENERATE with: openssl rand -hex 24
N8N_DB_PASSWORD=GENERATE
N8N_DB_NAME=n8n


# =====================================================================
# OPEN WEBUI — unified AI chat interface (Ollama / OpenAI-compatible)
# Docs: services/open-webui/README.md
# =====================================================================
OPENWEBUI_IMAGE_TAG=v0.10.2
OPENWEBUI_HOST_PORT=3001
# Session/JWT signing key. GENERATE with: openssl rand -hex 32
# WARNING: if this changes, everyone is logged out and encrypted data breaks.
OPENWEBUI_SECRET_KEY=GENERATE
# Allow the first signup (becomes admin). Set "false" after creating your account.
OPENWEBUI_ENABLE_SIGNUP=true
# Model providers (all optional; configure at least one to be useful).
# Ollama on the Docker HOST: http://host.docker.internal:11434
# Ollama as a container on donalabs_edge: http://ollama:11434
OPENWEBUI_OLLAMA_BASE_URL=
# OpenAI-compatible API (OpenAI, LiteLLM, vLLM, OpenRouter, Groq, ...)
OPENWEBUI_OPENAI_API_BASE_URL=
OPENWEBUI_OPENAI_API_KEY=


# =====================================================================
# yt-dlp — media download utility (CLI, run on demand — not a server)
# Docs: services/ytdlp/README.md ; wrapper: services/ytdlp/ytdlp.sh
# =====================================================================
# yt-dlp PyPI package version baked into the image (pin the package, not a tag).
YTDLP_VERSION=2026.7.4
# Deno runtime version (required by the YouTube extractor), pinned via multi-stage build.
YTDLP_DENO_VERSION=2.9.1
# Host directory where downloaded media is written.
YTDLP_DOWNLOAD_DIR=./services/ytdlp/downloads


# =====================================================================
# CADDY — optional reverse proxy (automatic HTTPS). Opt-in: ./start.sh proxy
# Docs: proxy/README.md
# =====================================================================
CADDY_IMAGE_TAG=2-alpine
# Email for Let's Encrypt registration (required for real HTTPS certificates).
CADDY_ACME_EMAIL=
# Public hostnames routed to each service (used by proxy/caddy/Caddyfile).
# Leave *.localhost for local testing; set real DNS names for production.
CADDY_VAULTWARDEN_DOMAIN=vault.localhost
CADDY_CALCOM_DOMAIN=cal.localhost
CADDY_PLAUSIBLE_DOMAIN=analytics.localhost
CADDY_PENPOT_DOMAIN=design.localhost
CADDY_N8N_DOMAIN=n8n.localhost
CADDY_OPENWEBUI_DOMAIN=ai.localhost
