#!/usr/bin/env bash
# Fake `docker` for script tests. No daemon, no images: it simulates only the
# calls backup.sh and scripts/restore.sh make, driven by environment variables:
#
#   FAKE_RUNNING       space-separated container names reported by `docker ps`
#   FAKE_VOLUMES       space-separated volume names that `volume inspect` finds
#   FAKE_VOLUME_USERS  containers that mount each volume, as space-separated
#                      "volume=container[,container...]" pairs. `docker ps -a
#                      --filter volume=V` lists them all; without -a, only those
#                      also in FAKE_RUNNING (as the real CLI does)
#   FAKE_PGDUMP_FAIL   container whose `pg_dump` exits non-zero
#   FAKE_TAR_FAIL      volume whose tar snapshot (`docker run`) exits non-zero
#   FAKE_PSQL_FAIL     container whose `psql` restore exits non-zero
#   FAKE_PSQL_DIR      if set, `docker exec -i C psql ...` saves its stdin to
#                      $FAKE_PSQL_DIR/C.sql (what restore.sh piped into psql)
#   FAKE_VOLROOT       if set, a volume V is the directory $FAKE_VOLROOT/V and the
#                      `sh -c` of a `docker run` really runs (real tar, real rm)
#                      with its /src, /dst and /backup mounts mapped to host dirs.
#                      Any other absolute path (or a "..") in the command is
#                      refused, so a buggy script cannot delete host files.
#                      Unset: `docker run` only writes a placeholder tarball.
#   FAKE_LOG           file every invocation is appended to (one line per call)
set -euo pipefail

[ -n "${FAKE_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_LOG"

in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# `docker run` with FAKE_VOLROOT: map the container paths in the shell command to
# host directories and run it. Refuses anything it could not map, so a bad
# mapping can never turn `rm -rf /dst/*` into a host-wide delete.
run_mapped() {
  local mount="$1" vol="$2" backup_dir="$3" cmd="$4" voldir
  [ -n "$vol" ] && [ -n "$backup_dir" ] && [ -d "$FAKE_VOLROOT" ] \
    || { echo "fake docker: cannot map run (vol='$vol' backup='$backup_dir')" >&2; exit 1; }
  voldir="$FAKE_VOLROOT/$vol"
  mkdir -p "$voldir"
  # Volume path first: the backup dir path contains "/backups", never "/dst".
  cmd="${cmd//\/$mount/$voldir}"
  cmd="${cmd//\/backup\//$backup_dir/}"
  if [[ " $cmd " =~ [[:space:]]/(src|dst|backup)(/|[[:space:]]) ]]; then
    echo "fake docker: unmapped container path in: $cmd" >&2; exit 1
  fi
  # This runs the script's command on the HOST, so every absolute path in it must
  # be inside the volume dir or the backup dir (or be /dev/null). A buggy script
  # with `rm -rf /some/host/path` or `/dst/../..` is refused instead of run.
  local tok path
  set -f   # tokens like /dst/* are checked as text, not expanded
  for tok in $cmd; do
    path="${tok#*>}"; path="${path%;}"
    case "$path" in /*) ;; *) continue ;; esac
    case "$path/" in */../*) echo "fake docker: '..' in path: $path" >&2; exit 1 ;; esac
    case "$path" in
      /dev/null|"$voldir"|"$voldir"/*|"$backup_dir"|"$backup_dir"/*) ;;
      *) echo "fake docker: path outside the sandbox: $path" >&2; exit 1 ;;
    esac
  done
  set +f
  sh -c "$cmd"
}

case "${1:-}" in
  info) exit 0 ;;
  compose) [ "${2:-}" = "version" ] && { echo "Docker Compose version v2-fake"; exit 0; }; exit 0 ;;
  ps)
    # One printf = one write: a reader that exits early (grep -q) cannot SIGPIPE
    # the fake halfway through and turn "running" into "not running".
    filter="" all=0
    for a in "$@"; do
      case "$a" in volume=*) filter="${a#volume=}" ;; -a|--all) all=1 ;; esac
    done
    if [ -n "$filter" ]; then
      out=""
      for pair in ${FAKE_VOLUME_USERS:-}; do
        [ "${pair%%=*}" = "$filter" ] || continue
        users="${pair#*=}"
        for c in ${users//,/ }; do
          # Like the real CLI: without -a only running containers are listed.
          [ "$all" -eq 1 ] || in_list "$c" "${FAKE_RUNNING:-}" || continue
          out="$out$c"$'\n'
        done
      done
      printf '%s' "$out"
      exit 0
    fi
    # shellcheck disable=SC2086  # word splitting of the name list is the point
    [ -z "${FAKE_RUNNING:-}" ] || printf '%s\n' $FAKE_RUNNING ;;
  exec)
    shift
    interactive=0
    [ "${1:-}" = "-i" ] && { interactive=1; shift; }
    container="$1"
    if [ "$interactive" -eq 1 ]; then
      input="$(cat)"   # always drain stdin, like a real psql would
      [ "$container" = "${FAKE_PSQL_FAIL:-}" ] && { echo "psql: error" >&2; exit 1; }
      [ -z "${FAKE_PSQL_DIR:-}" ] || printf '%s\n' "$input" > "$FAKE_PSQL_DIR/$container.sql"
      exit 0
    fi
    if [ "$container" = "${FAKE_PGDUMP_FAIL:-}" ]; then echo "pg_dump: error" >&2; exit 1; fi
    echo "-- fake dump of $container" ;;
  volume)
    [ "${2:-}" = "inspect" ] || exit 1
    in_list "$3" "${FAKE_VOLUMES:-}" ;;
  run)
    vol="" mount="" backup_dir="" last=""
    for a in "$@"; do
      case "$a" in
        *:/src:ro)    vol="${a%%:/src:ro}"; mount=src ;;
        *:/dst)       vol="${a%%:/dst}"; mount=dst ;;
        *:/backup:ro) backup_dir="${a%%:/backup:ro}" ;;
        *:/backup)    backup_dir="${a%%:/backup}" ;;
      esac
      last="$a"
    done
    [ "$vol" = "${FAKE_TAR_FAIL:-}" ] && { echo "tar: error" >&2; exit 1; }
    if [ -n "${FAKE_VOLROOT:-}" ]; then run_mapped "$mount" "$vol" "$backup_dir" "$last"; exit $?; fi
    name="$(sed -n 's#.*tar czf /backup/\([^ ]*\).*#\1#p' <<< "$last")"
    [ -n "$backup_dir" ] && [ -n "$name" ] || { echo "fake docker: unexpected run: $*" >&2; exit 1; }
    echo "fake tar of $vol" > "$backup_dir/$name" ;;
  stop|start) exit 0 ;;
  *) echo "fake docker: unsupported: $*" >&2; exit 1 ;;
esac
